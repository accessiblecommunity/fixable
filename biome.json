{
  "$schema": "https://biomejs.dev/schemas/2.4.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "site/src/**/*.ts",
      "site/src/**/*.tsx",
      "site/src/**/*.js",
      "site/src/**/*.mjs",
      "site/scripts/**/*.ts",
      "site/*.mjs",
      "!node_modules",
      "!site/dist",
      "!site/.astro",
      "!site/src/lib/wcag2.json",
      "!site/src/lib/wcag2-details.json",
      "!site/src/lib/wcag3.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "recommended": false
      },
      "style": {
        "noNonNullAssertion": "warn",
        "useImportType": "warn"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
