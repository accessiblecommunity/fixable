{
  "name": "fixable",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "dev:fixed": "cross-env PUBLIC_FIXED=1 astro dev",
    "start": "astro dev",
    "check": "astro check",
    "build": "astro check && astro build",
    "build:fixed": "astro check && cross-env PUBLIC_FIXED=1 astro build",
    "preview": "astro preview",
    "astro": "astro",
    "biome": "biome check",
    "biome:fix": "biome check --fix",
    "eslint": "eslint .",
    "eslint:fix": "eslint --fix .",
    "stylelint": "stylelint 'src/assets/styles/**/*.css'",
    "stylelint:fix": "stylelint --fix 'src/assets/styles/**/*.css'",
    "markdownlint": "markdownlint 'src/content/**/*.md'",
    "format": "biome format --write && prettier --write .",
    "format:check": "biome format && prettier --check .",
    "lint": "biome lint && eslint . && stylelint 'src/assets/styles/**/*.css'",
    "lint:fix": "biome lint --fix && eslint --fix . && stylelint --fix 'src/assets/styles/**/*.css'"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^6.3.1",
    "@fontsource-variable/cabin": "^5.0.19",
    "@fontsource/corinthia": "^5.0.21",
    "@fontsource/patua-one": "^5.0.19",
    "astro": "^5.7.13",
    "astro-icon": "^1.1.5",
    "cheerio": "^1.0.0",
    "fast-glob": "^3.3.2",
    "github-slugger": "^2.0.0",
    "lodash-es": "^4.17.21",
    "typescript": "^5.8.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@biomejs/biome": "^2.4.4",
    "@iconify-json/ri": "^1.1.21",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.14.14",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.3",
    "eslint-plugin-astro": "^1.6.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "markdownlint-cli": "^0.47.0",
    "prettier": "3.3.2",
    "prettier-plugin-astro": "^0.14.1",
    "stylelint": "^17.4.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
